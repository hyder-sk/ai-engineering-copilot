{
  "name": "@aec/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "phase1": "tsx src/scripts/run-phase1.ts",
    "phase2": "tsx src/scripts/run-phase2.ts",
    "phase3": "tsx src/scripts/run-phase3.ts",
    "langgraph:dev": "npx @langchain/langgraph-cli dev"
  },
  "dependencies": {
    "@aec/config": "*",
    "@aec/shared": "*",
    "@langchain/classic": "^1.0.47",
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.11",
    "@langchain/textsplitters": "^1.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  }
}
